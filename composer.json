{
    "name": "jayaitch/giraffeui",
    "description": "Free, accessible Blade + Alpine components for Laravel and Tailwind CSS v4. Livewire-friendly, never Livewire-required.",
    "keywords": [
        "laravel",
        "blade",
        "components",
        "tailwindcss",
        "alpinejs",
        "livewire",
        "ui"
    ],
    "homepage": "https://github.com/Jarryd-W-Hoffman/GiraffeUI",
    "license": "MIT",
    "authors": [
        {
            "name": "Jarryd Hoffman",
            "email": "jarryd.hoffman@windowslive.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/view": "^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "JayAitch\\GiraffeUI\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JayAitch\\GiraffeUI\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint",
        "lint:check": "pint --test",
        "catalog": [
            "Composer\\Config::disableProcessTimeout",
            "npm run catalog:css",
            "@php vendor/bin/testbench serve --port=8000"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "JayAitch\\GiraffeUI\\GiraffeUIServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
